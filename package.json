{
  "name": "openmail-mcp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @openmail/web dev",
    "build": "pnpm -r build",
    "lint": "eslint packages/*/src apps/worker/src && pnpm --filter @openmail/web lint",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "setup": "node --env-file=.env --import tsx scripts/setup.ts",
    "db:migrate": "supabase db push",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.37.0",
    "@playwright/test": "1.55.1",
    "@types/node": "24.7.2",
    "eslint": "9.37.0",
    "prettier": "3.6.2",
    "supabase": "2.120.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
